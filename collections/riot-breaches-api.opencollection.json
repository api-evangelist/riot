{
  "opencollection": "1.0.0",
  "info": {
    "name": "Riot Breaches API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Breaches",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List breaches",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://public-api.tryriot.com/v1/breaches",
            "headers": [
              {
                "name": "x-item-limit",
                "value": ""
              },
              {
                "name": "x-next-cursor",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "cursor",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "workspace_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "status",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Lists all breaches for a workspace with their affected employees count and status.\n\n**Scopes required:**\n- breaches:read"
        },
        {
          "info": {
            "name": "Get breaches statistics",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://public-api.tryriot.com/v1/breaches/statistics",
            "params": [
              {
                "name": "workspace_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "breached_after",
                "value": "",
                "type": "query"
              },
              {
                "name": "breached_before",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Retrieves statistics about breaches for a given workspace, including impacted employees count, acknowledged employees count, and warned employees count.\n\n**Scopes required:**\n- breaches:read"
        },
        {
          "info": {
            "name": "List compromised employees for a breach",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://public-api.tryriot.com/v1/breaches/:breach_id/compromised-employees",
            "headers": [
              {
                "name": "x-item-limit",
                "value": ""
              },
              {
                "name": "x-next-cursor",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "cursor",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "breach_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "workspace_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "warned",
                "value": "",
                "type": "query"
              },
              {
                "name": "acknowledged",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Lists all employees affected by a specific breach, ordered by their compromise date in descending order (most recent first).\nThe breach notification and acknowledgement dates, and breached email accounts are provided.\n\n\n**Scopes required:**\n- breaches:read"
        }
      ]
    }
  ],
  "bundled": true
}