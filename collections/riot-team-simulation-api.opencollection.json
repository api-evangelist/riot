              },
              {
                "name": "is_tricked",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Retrieves a list of attacks of a campaign with associated events, sorted by their creation date in descending order (most recent entries first).\n\n**Scopes required:**\n- simulation:read"
        },
