        {
          "info": {
            "name": "Get employee statistics",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://public-api.tryriot.com/v1/employees/statistics",
            "params": [
              {
                "name": "workspace_id",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Retrieves statistics about employees in a workspace grouped by status.\n\n**Scopes required:**\n- workspace:read"
        },
        {
          "info": {
            "name": "Get employee details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://public-api.tryriot.com/v1/employees/:employee_id",
            "params": [
              {
                "name": "employee_id",
                "value": "",
                "type": "path"
              }
