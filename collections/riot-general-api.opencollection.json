            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Retrieves details for a specific employee by ID.\n\n**Scopes required:**\n- workspace:read"
        },
        {
          "info": {
            "name": "Get organization",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://public-api.tryriot.com/v1/organization",
            "auth": {
              "type": "apikey",
