        },
        {
          "info": {
            "name": "List employees",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://public-api.tryriot.com/v1/employees",
            "headers": [
              {
                "name": "x-item-limit",
                "value": ""
              },
              {
                "name": "x-next-cursor",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "cursor",
                "value": "",
